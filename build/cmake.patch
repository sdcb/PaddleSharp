+## 逐条调用 Python，避免单一 execute_process 聚合时 Windows 下前置目录未必可见的问题
+set(_parse_fail FALSE)
+
+function(RUN_PARSE _yaml _out)
+  # 自动判断是否为 backward 类 yaml，匹配规则：包含 "backward" 子串
+  string(FIND "${_yaml}" "backward" _has_backward)
+  if(_has_backward GREATER -1)
+    set(_is_backward TRUE)
+  else()
+    set(_is_backward FALSE)
   endif()
-endforeach()
+
+  # 构造命令
+  set(_cmd ${PYTHON_EXECUTABLE} parse_op.py --op_yaml_path "${_yaml}" --output_path "${_out}")
+  if(_is_backward)
+    list(APPEND _cmd --backward)
+  endif()
+
+  execute_process(
+    WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}/paddle/fluid/operators/generator
+    COMMAND ${_cmd}
+    RESULT_VARIABLE _ret)
+  if(NOT _ret EQUAL 0)
+    message(WARNING "parse_op failed for ${_yaml} -> ${_out}, code=${_ret}")
+    set(_parse_fail TRUE PARENT_SCOPE)
+  endif()
+endfunction()
+
