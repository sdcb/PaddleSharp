+  key.append(std::to_string(is_bfloat16));
+  key.append("_");
+  key.append(fuse_activation);
+  key.append("_");
+  key.append(std::to_string(fuse_residual_conn));
+  key.append("_");
+  key.append(std::to_string(force_fp32_output));
+  return key;
+}
