+                                     bool is_bfloat16,
+                                     const std::string& fuse_activation,
+                                     bool fuse_residual_conn,
+                                     bool force_fp32_output) {
+  if (dev_ctx.HasInputsName("Input") && dev_ctx.HasInputsName("Filter")) {
+    return dev_ctx.GetInputsName("Input")[0] +
